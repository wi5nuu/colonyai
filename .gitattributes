* text=auto

# Python
*.py text diff=python
*.pyx text
*.pxd text

# JavaScript/TypeScript
*.ts text diff=typescript
*.tsx text
*.js text
*.jsx text
*.json text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# YAML
*.yml text
